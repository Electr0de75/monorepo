# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Token du bot (@BotFather). Le même que ton bot de tweets si celui-ci ne fait
# qu'ENVOYER des messages ; sinon un 2e bot (voir README > "Même bot").
TELEGRAM_BOT_TOKEN=
# Ton ID Telegram (plusieurs possibles, séparés par des virgules).
# Laisse vide au 1er lancement puis envoie /start au bot : il te donne ton ID.
TELEGRAM_ALLOWED_USERS=
# Chat qui reçoit les notifs (vide = ton chat privé). Pour un groupe : -100xxxxxxxxxx
TELEGRAM_NOTIFY_CHAT_ID=
TIMEZONE=Europe/Paris
DB_PATH=ticker_scanner.db

# ---------------------------------------------------------------------------
# EVM temps réel (optionnel, par chaîne). Sans URL -> DexScreener uniquement.
# Mets l'URL WSS (websocket) d'Alchemy/QuickNode/...; l'URL HTTP est déduite
# automatiquement (wss:// -> https://) sauf si tu la précises.
# Sans websocket, une URL HTTP seule suffit (mode polling).
# ---------------------------------------------------------------------------
BSC_WS_URL=
BSC_HTTP_URL=
ROBINHOOD_WS_URL=
# RPC public officiel Robinhood Chain (gratuit, sans clé) :
ROBINHOOD_HTTP_URL=https://rpc.mainnet.chain.robinhood.com
ETHEREUM_WS_URL=
ETHEREUM_HTTP_URL=
BASE_WS_URL=
BASE_HTTP_URL=
ARBITRUM_WS_URL=
ARBITRUM_HTTP_URL=
# Taille max d'un eth_getLogs (10 = compatible offre gratuite Alchemy)
EVM_GETLOGS_MAX_RANGE=10
EVM_POLL_INTERVAL=2

# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------
# pump.fun + bonk.fun via PumpPortal : gratuit, sans clé.
PUMPPORTAL_ENABLED=true
# Helius (gratuit) pour LaunchLab (bonk.fun, StonkFun), Meteora DBC (Bags,
# Believe…), Moonshot, Boop : wss://mainnet.helius-rpc.com/?api-key=TA_CLE
SOLANA_WS_URL=
SOLANA_HTTP_URL=

# ---------------------------------------------------------------------------
# DexScreener (toutes les chaînes, sans clé)
# ---------------------------------------------------------------------------
DEXSCREENER_INTERVAL=15
LOG_LEVEL=INFO
